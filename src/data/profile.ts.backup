export interface Profile {
  name: string;
  nickname: string;
  role: string;
  tagline: string;
  bio: string;
  stack: string[];
  contact: {
    email: string;
    github: string;
    linkedin: string;
  };
}

export interface Metric {
  label: string;
  value: string;
  description: string;
  icon: string;
}

export interface Project {
  id: string;
  title: string;
  problem: string;
  solution: string;
  outcome: string;
  stack: string[];
  links: {
    github?: string;
    live?: string;
  };
  architecture?: string;
  // Tech Lead View - Advanced details
  designDecisions?: {
    title: string;
    rationale: string;
  }[];
  tradeoffs?: string[];
  technicalNotes?: string;
}

export interface Incident {
  id: string;
  severity: 'SEV-1' | 'SEV-2' | 'SEV-3';
  title: string;
  symptom: string;
  rootCause: string;
  fix: string;
  prevention: string;
  timestamp: string;
  // Tech Lead View - Technical depth
  technicalDetails?: string;
  toolsUsed?: string[];
}

export interface Playbook {
  category: string;
  skills: string[];
  tools: string[];
}

export interface Experience {
  id: string;
  role: string;
  company: string;
  period: string;
  responsibilities: string[];
  impact: string;
  // Tech Lead View - Technical context
  technicalContext?: {
    architecture: string;
    scale: string;
    challenges: string[];
  };
}

